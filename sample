from typing import List, Optional, Any
from pydantic import BaseModel, Field


class QueryEntity(BaseModel):
    name: str = Field(
        description="Entity or concept mentioned by the user, such as Customer, Product, Order"
    )

    value: Optional[str] = Field(
        default=None,
        description="Specific value associated with the entity, if provided"
    )


class QueryFilter(BaseModel):
    field: str = Field(
        description="Property on which the filter should be applied"
    )

    operator: str = Field(
        description="Comparison operator such as =, >, <, >=, <=, contains"
    )

    value: Any = Field(
        description="Value used for filtering"
    )


class QueryRelationship(BaseModel):
    source: str = Field(
        description="Source entity"
    )

    relation: str = Field(
        description="Relationship between the source and target entities"
    )

    target: str = Field(
        description="Target entity"
    )


class Aggregation(BaseModel):
    function: str = Field(
        description="Aggregation function such as COUNT, SUM, AVG, MIN, MAX"
    )

    field: str = Field(
        description="Field on which the aggregation should be applied"
    )

    alias: Optional[str] = Field(
        default=None,
        description="Optional name for the aggregated result"
    )


class SortCondition(BaseModel):
    field: str

    direction: str = Field(
        default="ASC",
        description="ASC or DESC"
    )


class NaturalLanguageQuery(BaseModel):

    intent: str = Field(
        description="Main intent of the user's request"
    )

    target_entities: List[str] = Field(
        default_factory=list,
        description="Main RDF entities/classes the user wants information about"
    )

    requested_fields: List[str] = Field(
        default_factory=list,
        description="Properties the user wants returned"
    )

    entities: List[QueryEntity] = Field(
        default_factory=list,
        description="Entities and explicit values detected in the user request"
    )

    relationships: List[QueryRelationship] = Field(
        default_factory=list,
        description="Relationships required to answer the query"
    )

    filters: List[QueryFilter] = Field(
        default_factory=list,
        description="Conditions extracted from the user request"
    )

    aggregations: List[Aggregation] = Field(
        default_factory=list
    )

    group_by: List[str] = Field(
        default_factory=list
    )

    sort: List[SortCondition] = Field(
        default_factory=list
    )

    limit: Optional[int] = None

    clarification_required: bool = False

    clarification_question: Optional[str] = None
