# ============================================================
# HELPERS
# ============================================================

def normalize(text: str) -> str:
    """Normalize text for matching."""
    text = str(text).lower()
    text = re.sub(r"[_\-]+", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def contains_phrase(text: str, phrase: str) -> bool:
    """Match complete words or phrases."""
    phrase = normalize(phrase)

    if not phrase:
        return False

    pattern = (
        r"(?<!\w)"
        + re.escape(phrase)
        + r"(?!\w)"
    )

    return bool(re.search(pattern, text))


def load_schemas() -> dict:
    """
    Load an optional JSON schema registry.

    Deploy templates.json alongside this module to extend
    the registry without changing the resolver logic.
    """
    registry = dict(DEFAULT_SCHEMAS)

    path = Path(__file__).resolve().parent / "templates.json"

    if path.exists():
        with path.open("r", encoding="utf-8") as file:
            external = json.load(file)

        if not isinstance(external, dict):
            raise ValueError("Schema registry must be an object")

        for name, schema in external.items():
            if not isinstance(schema, dict):
                continue

            columns = schema.get("columns", [])

            if not isinstance(columns, list):
                continue

            if not columns or not all(
                isinstance(column, str) and column.strip()
                for column in columns
            ):
                continue

            registry[name] = schema

    return registry


def score_template(query: str, name: str, schema: dict) -> int:
    """Score a template using names and business synonyms."""
    score = 0

    if contains_phrase(query, name):
        score += 10

    for keyword in schema.get("keywords", []):
        if contains_phrase(query, keyword):
            score += 5

    for column, aliases in schema.get(
        "field_aliases", {}
    ).items():
        if contains_phrase(query, column):
            score += 2

        for alias in aliases:
            if contains_phrase(query, alias):
                score += 3

    return score


def find_requested_columns(query: str, schema: dict) -> list:
    """Identify explicitly requested attributes."""
    columns = schema["columns"]
    aliases = schema.get("field_aliases", {})

    selected = []

    for column in columns:
        terms = [column] + aliases.get(column, [])

        if any(contains_phrase(query, term) for term in terms):
            selected.append(column)

    return selected


def resolve_schemas(
    user_query: str,
    previous_template: str = ""
) -> dict[str, Any]:
    """
    Resolve business intent to registered Excel schemas.

    Supports multiple template matches, exact column order,
    requested fields, and follow-up context.
    """
    schemas = load_schemas()
    query = normalize(user_query)

    if not query:
        return {
            "status": "invalid_request",
            "message": "User query cannot be empty"
        }

    ranked = []

    for name, schema in schemas.items():
        score = score_template(query, name, schema)

        if score > 0:
            ranked.append({
                "name": name,
                "score": score,
                "schema": schema
            })

    ranked.sort(
        key=lambda item: item["score"],
        reverse=True
    )

    # Context fallback for follow-up questions.
    if not ranked and previous_template in schemas:
        ranked.append({
            "name": previous_template,
            "score": 1,
            "schema": schemas[previous_template]
        })

    if not ranked:
        return {
            "status": "not_found",
            "message": (
                "No matching registered template. "
                "Continue with normal Voicebox retrieval."
            ),
            "available_templates": list(schemas.keys())
        }

    results = []

    for match in ranked:
        schema = match["schema"]
        columns = schema["columns"]

        requested = find_requested_columns(
            query, schema
        )

        results.append({
            "template": match["name"],
            "description": schema.get(
                "description", ""
            ),
            "columns": columns,
            "requested_columns": requested,
            "column_count": len(columns),
            "field_aliases": schema.get(
                "field_aliases", {}
            )
        })

    return {
        "status": (
            "matched" if len(results) == 1
            else "multiple_matches"
        ),
        "templates": results,
        "message": (
            "Use the resolved column names and order. "
            "Retrieve values exclusively from Voicebox. "
            "Do not invent missing values."
        )
    }


# ============================================================
# WATSONX ORCHESTRATE TOOL
# ============================================================

@tool
def schema_resolver(
    user_query: str,
    previous_template: str = ""
) -> str:
    """
    Identify the predefined Excel data schema matching
    the user's account-related request.

    Use this tool before Voicebox Ask when the request
    requires structured account information, tables,
    schedules, lists, or multiple account attributes.

    The tool returns matching template names, ordered
    columns, field aliases, and explicitly requested fields.

    It does not retrieve account data. Voicebox Ask must
    be used to obtain actual account values.

    Args:
        user_query: Current user question, including any
            clarified account or business intent.
        previous_template: Previously resolved template
            name for contextual follow-up questions.
            Leave empty when no previous template exists.

    Returns:
        JSON string containing the resolved schema
        information or a no-match result.
    """
    try:
        result = resolve_schemas(
            user_query=user_query,
            previous_template=previous_template
        )

    except Exception:
        result = {
            "status": "error",
            "message": (
                "Schema resolution failed. "
                "Continue with Voicebox retrieval "
                "without assuming a template."
            )
        }

    return json.dumps(result, ensure_ascii=False)









spec_version: v1
kind: native

name: orchestrate_test_agent

description: >
  Intelligent account information assistant that retrieves
  account data from Stardog Voicebox and dynamically organizes
  information using predefined business schemas.

llm: virtual-model/openai-oauth2-client-creds/gemini-3.5-flash

style: react_core
hide_reasoning: false

instructions: |-
  You are an intelligent account information assistant.

  DATA SOURCE:
  - All account data must come from Voicebox Ask.
  - Never invent, infer, or supplement account values.
  - Treat Voicebox results as the authoritative source.

  INTENT UNDERSTANDING:
  - Understand the user's intent, account references,
    requested attributes, filters, and conversation context.
  - Recognize business concepts using semantic meaning,
    not only exact keywords.
  - Preserve relevant context across follow-up questions.

  SCHEMA RESOLUTION:
  - For structured account information requests, invoke
    schema_resolver before retrieving account data.
  - Use the resolved template to determine the appropriate
    attributes and expected column order.
  - Use the complete schema when the user requests full
    details, complete records, or all relevant attributes.
  - For specific attribute questions, retrieve and display
    only the necessary information.
  - For follow-up questions, reuse the previous template
    when the underlying intent has not changed.
  - For multiple matched templates, handle each relevant
    structure independently.
  - If no schema matches, proceed with normal Voicebox
    retrieval without forcing a predefined format.

  VOICEBOX RETRIEVAL:
  - Always use Voicebox Ask for account information.
  - Construct the retrieval request using the user's intent,
    account references, filters, and resolved attributes.
  - Retrieve the necessary information without assuming
    that every template attribute is available.
  - Do not generate missing account values.

  DATA EXTRACTION:
  - Use Extraction_Tool when the Voicebox response requires
    extraction, restructuring, or tabular organization.
  - Map retrieved attributes to the resolved schema.
  - Preserve exact field names, values, and record associations.
  - Preserve predefined column order when a schema exists.
  - Do not infer missing attributes from unrelated fields.
  - Represent unavailable values as N/A.
  - Never combine values belonging to different accounts.

  RESPONSE GENERATION:
  - Select the response structure based on user intent.
  - For full structured results, display a readable table.
  - For specific questions, provide a concise direct answer.
  - For multiple records, preserve record-level associations.
  - Preserve the resolved schema's column order when relevant.
  - Do not introduce unsupported columns or account values.
  - If requested information is unavailable, state that clearly.
  - Respond naturally without unnecessary explanations.
  - Do not expose private internal reasoning.

  TOOL EFFICIENCY:
  - Avoid unnecessary or duplicate tool invocations.
  - Reuse relevant conversation context when appropriate.
  - Invoke schema_resolver when a new structured intent
    requires schema identification.
  - Reuse an established schema for unchanged follow-up intent.
  - Invoke Voicebox when new account data is required.
  - Use Extraction_Tool only when restructuring is needed.

tools:
  - schema_resolver
  - Extraction_Tool
  - coax-voicebox-custprof-testconn:voicebox_ask

