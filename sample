# ============================================================
# HELPERS
# ============================================================

def normalize(text: str) -> str:
    """Normalize text for matching."""
    text = str(text).lower()
    text = re.sub(r"[_\-]+", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def contains_phrase(text: str, phrase: str) -> bool:
    """Match complete words or phrases."""
    phrase = normalize(phrase)

    if not phrase:
        return False

    pattern = (
        r"(?<!\w)"
        + re.escape(phrase)
        + r"(?!\w)"
    )

    return bool(re.search(pattern, text))


def load_schemas() -> dict:
    """
    Load an optional JSON schema registry.

    Deploy templates.json alongside this module to extend
    the registry without changing the resolver logic.
    """
    registry = dict(DEFAULT_SCHEMAS)

    path = Path(__file__).resolve().parent / "templates.json"

    if path.exists():
        with path.open("r", encoding="utf-8") as file:
            external = json.load(file)

        if not isinstance(external, dict):
            raise ValueError("Schema registry must be an object")

        for name, schema in external.items():
            if not isinstance(schema, dict):
                continue

            columns = schema.get("columns", [])

            if not isinstance(columns, list):
                continue

            if not columns or not all(
                isinstance(column, str) and column.strip()
                for column in columns
            ):
                continue

            registry[name] = schema

    return registry


def score_template(query: str, name: str, schema: dict) -> int:
    """Score a template using names and business synonyms."""
    score = 0

    if contains_phrase(query, name):
        score += 10

    for keyword in schema.get("keywords", []):
        if contains_phrase(query, keyword):
            score += 5

    for column, aliases in schema.get(
        "field_aliases", {}
    ).items():
        if contains_phrase(query, column):
            score += 2

        for alias in aliases:
            if contains_phrase(query, alias):
                score += 3

    return score


def find_requested_columns(query: str, schema: dict) -> list:
    """Identify explicitly requested attributes."""
    columns = schema["columns"]
    aliases = schema.get("field_aliases", {})

    selected = []

    for column in columns:
        terms = [column] + aliases.get(column, [])

        if any(contains_phrase(query, term) for term in terms):
            selected.append(column)

    return selected


def resolve_schemas(
    user_query: str,
    previous_template: str = ""
) -> dict[str, Any]:
    """
    Resolve business intent to registered Excel schemas.

    Supports multiple template matches, exact column order,
    requested fields, and follow-up context.
    """
    schemas = load_schemas()
    query = normalize(user_query)

    if not query:
        return {
            "status": "invalid_request",
            "message": "User query cannot be empty"
        }

    ranked = []

    for name, schema in schemas.items():
        score = score_template(query, name, schema)

        if score > 0:
            ranked.append({
                "name": name,
                "score": score,
                "schema": schema
            })

    ranked.sort(
        key=lambda item: item["score"],
        reverse=True
    )

    # Context fallback for follow-up questions.
    if not ranked and previous_template in schemas:
        ranked.append({
            "name": previous_template,
            "score": 1,
            "schema": schemas[previous_template]
        })

    if not ranked:
        return {
            "status": "not_found",
            "message": (
                "No matching registered template. "
                "Continue with normal Voicebox retrieval."
            ),
            "available_templates": list(schemas.keys())
        }

    results = []

    for match in ranked:
        schema = match["schema"]
        columns = schema["columns"]

        requested = find_requested_columns(
            query, schema
        )

        results.append({
            "template": match["name"],
            "description": schema.get(
                "description", ""
            ),
            "columns": columns,
            "requested_columns": requested,
            "column_count": len(columns),
            "field_aliases": schema.get(
                "field_aliases", {}
            )
        })

    return {
        "status": (
            "matched" if len(results) == 1
            else "multiple_matches"
        ),
        "templates": results,
        "message": (
            "Use the resolved column names and order. "
            "Retrieve values exclusively from Voicebox. "
            "Do not invent missing values."
        )
    }


# ============================================================
# WATSONX ORCHESTRATE TOOL
# ============================================================

@tool
def schema_resolver(
    user_query: str,
    previous_template: str = ""
) -> str:
    """
    Identify the predefined Excel data schema matching
    the user's account-related request.

    Use this tool before Voicebox Ask when the request
    requires structured account information, tables,
    schedules, lists, or multiple account attributes.

    The tool returns matching template names, ordered
    columns, field aliases, and explicitly requested fields.

    It does not retrieve account data. Voicebox Ask must
    be used to obtain actual account values.

    Args:
        user_query: Current user question, including any
            clarified account or business intent.
        previous_template: Previously resolved template
            name for contextual follow-up questions.
            Leave empty when no previous template exists.

    Returns:
        JSON string containing the resolved schema
        information or a no-match result.
    """
    try:
        result = resolve_schemas(
            user_query=user_query,
            previous_template=previous_template
        )

    except Exception:
        result = {
            "status": "error",
            "message": (
                "Schema resolution failed. "
                "Continue with Voicebox retrieval "
                "without assuming a template."
            )
        }

    return json.dumps(result, ensure_ascii=False)
