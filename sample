from typing import List, Optional, Any
from pydantic import BaseModel, Field
from ibm_watsonx_orchestrate.agent_builder.tools import tool


class QueryEntity(BaseModel):
    name: str = Field(
        description="Entity or concept identified from the user request"
    )
    value: Optional[str] = Field(
        default=None,
        description="Specific value associated with the entity"
    )


class QueryFilter(BaseModel):
    field: str = Field(
        description="Property or field used for filtering"
    )
    operator: str = Field(
        description="Operator such as =, >, <, >=, <=, contains"
    )
    value: Any = Field(
        description="Value used in the filter"
    )


class QueryRelationship(BaseModel):
    source: str = Field(
        description="Source entity"
    )
    relation: str = Field(
        description="Relationship between entities"
    )
    target: str = Field(
        description="Target entity"
    )


class Aggregation(BaseModel):
    function: str = Field(
        description="COUNT, SUM, AVG, MIN or MAX"
    )
    field: str = Field(
        description="Field used for aggregation"
    )
    alias: Optional[str] = Field(
        default=None,
        description="Alias for the aggregated value"
    )


class SortCondition(BaseModel):
    field: str = Field(
        description="Field used for sorting"
    )
    direction: str = Field(
        default="ASC",
        description="ASC or DESC"
    )


class SemanticQueryModel(BaseModel):
    intent: str = Field(
        description="Main intent of the user's request"
    )

    target_entities: List[str] = Field(
        default_factory=list,
        description="Primary entities the user wants information about"
    )

    requested_fields: List[str] = Field(
        default_factory=list,
        description="Fields or attributes the user wants returned"
    )

    entities: List[QueryEntity] = Field(
        default_factory=list
    )

    relationships: List[QueryRelationship] = Field(
        default_factory=list
    )

    filters: List[QueryFilter] = Field(
        default_factory=list
    )

    aggregations: List[Aggregation] = Field(
        default_factory=list
    )

    group_by: List[str] = Field(
        default_factory=list
    )

    sort: List[SortCondition] = Field(
        default_factory=list
    )

    limit: Optional[int] = None

    clarification_required: bool = False

    clarification_question: Optional[str] = None






@tool
def semantic_query_extractor(
    intent: str,
    target_entities: List[str],
    requested_fields: List[str],
    entities: List[dict],
    relationships: List[dict],
    filters: List[dict],
    aggregations: List[dict],
    group_by: List[str],
    sort: List[dict],
    limit: Optional[int] = None,
    clarification_required: bool = False,
    clarification_question: Optional[str] = None
) -> dict:
    """
    Creates and validates a structured semantic representation of a
    user's natural-language database query.

    Use this tool after understanding the user's intent.

    Do not invent entities, relationships, properties, filters, or values.

    Returns:
        Validated semantic query information that can be used by a
        downstream SPARQL generator.
    """

    try:
        model = SemanticQueryModel(
            intent=intent,
            target_entities=target_entities,
            requested_fields=requested_fields,
            entities=entities,
            relationships=relationships,
            filters=filters,
            aggregations=aggregations,
            group_by=group_by,
            sort=sort,
            limit=limit,
            clarification_required=clarification_required,
            clarification_question=clarification_question
        )

        return {
            "status": "success",
            "semantic_query": model.model_dump()
        }

    except Exception as e:
        return {
            "status": "error",
            "message": str(e)
        }
