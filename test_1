model_balanced = CatBoostClassifier(

    iterations=500,

    depth=6,

    learning_rate=0.05,

    loss_function='MultiClass',

    eval_metric='MultiClass',

    auto_class_weights='Balanced',

    random_seed=42,

    verbose=100

)

model_balanced.fit(

    X_train,

    y_train,

    cat_features=categorical_cols,

    eval_set=(X_test, y_test),

    early_stopping_rounds=50

)

y_pred_balanced = model_balanced.predict(X_test).reshape(-1)

print("Accuracy:",

      accuracy_score(y_test, y_pred_balanced))

print("Macro F1:",

      f1_score(

          y_test,

          y_pred_balanced,

          average='macro'

      ))

print("Weighted F1:",

      f1_score(

          y_test,

          y_pred_balanced,

          average='weighted'

      ))

print(

    classification_report(

        y_test,

        y_pred_balanced

    )

)

print(

    confusion_matrix(

        y_test,

        y_pred_balanced

    )

)
