import numpy as np
from sklearn.model_selection import StratifiedKFold
from sklearn.utils.class_weight import compute_sample_weight
from sklearn.metrics import f1_score
from sklearn.base import clone

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

scores = []

for fold, (train_idx, val_idx) in enumerate(cv.split(X_train_xgb, y_train_xgb), 1):

    X_tr = X_train_xgb.iloc[train_idx]
    X_val = X_train_xgb.iloc[val_idx]

    y_tr = y_train_xgb.iloc[train_idx]
    y_val = y_train_xgb.iloc[val_idx]

    # Calculate weights ONLY from this training fold
    sample_weights = compute_sample_weight(
        class_weight="balanced",
        y=y_tr
    )

    # Same XGBoost configuration as your current model
    model = clone(xgb_model)

    model.fit(
        X_tr,
        y_tr,
        sample_weight=sample_weights
    )

    pred = model.predict(X_val)

    score = f1_score(y_val, pred, average="macro")
    scores.append(score)

    print(f"Fold {fold}: {score:.4f}")

print("\nMean Macro F1:", np.mean(scores))
print("Std:", np.std(scores))
