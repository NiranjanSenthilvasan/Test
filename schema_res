# ============================================================
# HELPERS
# ============================================================

def normalize(text: str) -> str:
    """Normalize text for matching."""
    text = str(text).lower()
    text = re.sub(r"[_\-]+", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def contains_phrase(text: str, phrase: str) -> bool:
    """Match complete words or phrases."""
    phrase = normalize(phrase)

    if not phrase:
        return False

    pattern = (
        r"(?<!\w)" + re.escape(phrase) + r"(?!\w)"
    )

    return bool(re.search(pattern, text))


def score_template(
    query: str,
    name: str,
    schema: dict
) -> int:
    """Score a template using names and business synonyms."""
    score = 0

    if contains_phrase(query, name):
        score += 10

    for keyword in schema.get("keywords", []):
        if contains_phrase(query, keyword):
            score += 5

    for column, aliases in schema.get(
        "field_aliases", {}
    ).items():
        if contains_phrase(query, column):
            score += 2

        for alias in aliases:
            if contains_phrase(query, alias):
                score += 3

    return score


def find_requested_columns(
    query: str,
    schema: dict
) -> list:
    """
    Identify requested fields across main and nested sections.
    """
    selected = []

    # Main columns
    all_columns = list(schema.get("columns", []))

    # FIX: Include nested section columns
    for section in schema.get("sections", {}).values():
        all_columns.extend(section.get("columns", []))

    aliases = schema.get("field_aliases", {})

    for column in dict.fromkeys(all_columns):
        terms = [column] + aliases.get(column, [])

        if any(
            contains_phrase(query, term)
            for term in terms
        ):
            selected.append(column)

    return selected


def is_full_details_request(query: str) -> bool:
    """Identify requests for complete template information."""
    query = normalize(query)

    phrases = [
        "all details",
        "full details",
        "complete details",
        "all information",
        "complete information",
        "full information",
        "entire template",
        "show everything",
        "complete record",
        "full record",
        "billing center for",
        "billing center details",
        "show billing center",
        "billing center information",
        "billing for"
    ]

    return any(
        contains_phrase(query, phrase)
        for phrase in phrases
    )


# ============================================================
# SCHEMA RESOLUTION
# ============================================================

def resolve_schemas(
    user_query: str,
    previous_template: str = ""
) -> dict[str, Any]:

    query = normalize(user_query)

    if not query:
        return {
            "status": "invalid_request",
            "message": "User query cannot be empty"
        }

    matches = []

    for name, schema in DEFAULT_SCHEMAS.items():
        score = score_template(query, name, schema)

        if score > 0:
            matches.append((score, name, schema))

    # Previous template fallback
    if not matches and previous_template in DEFAULT_SCHEMAS:
        matches.append((
            1,
            previous_template,
            DEFAULT_SCHEMAS[previous_template]
        ))

    if not matches:
        return {
            "status": "not_found",
            "message": (
                "No matching template found. "
                "Continue with normal Voicebox retrieval."
            ),
            "available_templates": list(
                DEFAULT_SCHEMAS.keys()
            )
        }

    matches.sort(
        key=lambda item: item[0],
        reverse=True
    )

    best_score = matches[0][0]

    best_matches = [
        item for item in matches
        if item[0] == best_score
    ]

    results = []

    for score, name, schema in best_matches:

        # Main columns
        main_columns = list(schema.get("columns", []))

        # FIX: Include all nested section columns
        all_columns = list(main_columns)

        for section in schema.get(
            "sections", {}
        ).values():
            all_columns.extend(
                section.get("columns", [])
            )

        # Preserve original order and avoid duplicates
        all_columns = list(dict.fromkeys(all_columns))

        requested = find_requested_columns(
            query, schema
        )

        # Full requests use all available schema columns.
        # Specific requests use matching attributes.
        retrieval_columns = (
            all_columns
            if is_full_details_request(query) or not requested
            else requested
        )

        voicebox_question = (
            f"{user_query}. "
            f"Retrieve the following {name} attributes "
            f"where available: "
            f"{', '.join(retrieval_columns)}. "
            "Return only actual matching account records. "
            "Do not generate missing values."
        )

        results.append({
            "template": name,
            "description": schema.get(
                "description", ""
            ),
            "columns": all_columns,
            "main_columns": main_columns,
            "sections": schema.get("sections", {}),
            "requested_columns": requested,
            "retrieval_columns": retrieval_columns,
            "column_count": len(all_columns),
            "field_aliases": schema.get(
                "field_aliases", {}
            ),
            "voicebox_question": voicebox_question
        })

    return {
        "status": (
            "matched" if len(results) == 1
            else "ambiguous"
        ),
        "templates": results,
        "message": (
            "Use the resolved schema columns and order. "
            "For complete requests, include nested sections. "
            "Retrieve actual values exclusively from Voicebox."
        )
    }


# ============================================================
# WATSONX ORCHESTRATE TOOL
# ============================================================

@tool(permission=ToolPermission.READ_ONLY)
def schema_resolver(
    user_query: str,
    previous_template: str = ""
) -> str:
    """
    Identify the predefined Excel template schema matching
    the user's UPS account-related request.

    Supports Pickup, Center Contact Info, FEEDER,
    PEA Users, and Billing Center.

    Includes nested section columns and recognizes
    short requests such as 'billing'.

    Args:
        user_query: Current user question or clarified intent.
        previous_template: Previously resolved template for
            contextual follow-up questions. Leave empty
            if no previous template exists.

    Returns:
        JSON string containing matching templates, all
        ordered columns, sections, requested attributes,
        and a suggested Voicebox retrieval question.
    """
    try:
        result = resolve_schemas(
            user_query=user_query,
            previous_template=previous_template
        )

    except Exception:
        result = {
            "status": "error",
            "message": (
                "Schema resolution failed. "
                "Continue with normal Voicebox retrieval."
            )
        }

    return json.dumps(
        result,
        ensure_ascii=False
    )
